{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomoSingle",
  "version": "0.1.0",
  "identifier": "com.pomosingle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "windows": [
      {
        "label": "manage",
        "url": "index.html",
        "title": "PomoSingle",
        "width": 1000,
        "height": 680,
        "dragDropEnabled": false,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": true,
        "resizable": true
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "Quick Capture",
        "width": 620,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
